# Priya AI — environment variables
# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file (it is git-ignored).

# FREE-FIRST: Priya auto-routes FREE tier -> NO-KEY -> PAID providers.
# Free-tier providers below work with YOUR OWN free API key, no card needed.
# No-key providers (Pollinations, local Ollama / LM Studio) need NO key at all.
# Paid providers are used ONLY when you explicitly add a key, and only after
# all free options have failed.

# CHAT — free tier: Google Gemini API key (create one free at https://aistudio.google.com/apikey)
# Free tier: 15 req/min, 1,500 req/day on gemini-3.x flash models, no credit card.
GEMINI_API_KEY=YOUR_API_KEY_HERE

# CHAT — free tier: Groq API key (free, no credit card at https://console.groq.com/keys)
# Free tier: llama-3.3-70b-versatile — 30 req/min, ~1,000 req/day.
# GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# CHAT — free tier: OpenRouter API key (https://openrouter.ai/keys)
# Free models via the ":free" suffix or the "openrouter/free" router —
# 20 req/min, 50 req/day without purchased credits.
# OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE

# CHAT — free tier: Mistral key (https://console.mistral.ai/api-keys)
# Free Experiment plan: ~1B tokens/month, phone verification, no card.
# MISTRAL_API_KEY=YOUR_MISTRAL_API_KEY_HERE

# CHAT — free tier (tiny): Hugging Face token with Inference permission
# (https://huggingface.co/settings/tokens) — free accounts get ~$0.10/month.
# HF_API_KEY=YOUR_HF_API_KEY_HERE

# CHAT — no-key tier (nothing to configure):
#   Pollinations public endpoint: https://text.pollinations.ai (anonymous, ~1 req/15s)
#   Local Ollama:  http://127.0.0.1:11434  (start "ollama serve" + ollama pull llama3)
#   Local LM Studio: http://127.0.0.1:1234 (enable the OpenAI-compatible server)
# Local servers are detected automatically; no keys, no cost, no internet.

# CHAT — primary (paid, per-token): Sarvam AI. Indian-first LLM, native
# Hindi/Hinglish. Same key also powers Priya's voice engine.
# SARVAM_API_KEY=YOUR_SARVAM_API_KEY_HERE

# CHAT — paid, per-token (used ONLY when configured, and after free tiers fail):
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE        # https://platform.openai.com/api-keys
# ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE  # https://console.anthropic.com/settings/keys
# XAI_API_KEY=YOUR_XAI_API_KEY_HERE              # https://console.x.ai (Grok)
# DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY_HERE    # https://platform.deepseek.com/api_keys
# TOGETHER_API_KEY=YOUR_TOGETHER_API_KEY_HERE    # https://api.together.ai/settings/api-keys
# CEREBRAS_API_KEY=YOUR_CEREBRAS_API_KEY_HERE    # https://cloud.cerebras.ai ($5 trial credits, 30 days, card required)
# PERPLEXITY_API_KEY=YOUR_PERPLEXITY_API_KEY_HERE # https://www.perplexity.ai/settings/api

# Every provider key above can ALSO be entered at runtime from
# Settings -> AI Models & API (stored server-side, gitignored, no restart).

# VOICE — primary: Sarvam AI (best natural Hindi + Hinglish voices, free tier)
# Used for: Hindi, Indian English, Hinglish code-switching, Indian names.
# (Uses the same SARVAM_API_KEY as chat.)

# VOICE — fallback: ElevenLabs (used only if Sarvam is not configured or fails)
# Optional. Free plan: 10,000 credits/month at https://elevenlabs.io
# ELEVENLABS_API_KEY=YOUR_ELEVENLABS_API_KEY_HERE

# OPTIONAL: Chat provider fallback order (comma-separated).
# The model selected in Settings -> AI Models & API is always tried first.
# Default (free-first): gemini,groq,openrouter,mistral,huggingface,pollinations,ollama,lmstudio,sarvam,deepseek,openai,anthropic,xai,together,cerebras,perplexity
# Rate limits cool a provider down (60s -> 5min -> 30min -> 2h) and Priya
# switches automatically; invalid keys / exhausted quotas block for 12h.
# CHAT_PROVIDERS=gemini,groq,openrouter,mistral

# OPTIONAL: Live web search.
# WITHOUT a key: Priya searches with keyless engines (Bing/DuckDuckGo) — works
# but results can be unreliable (SEO junk is filtered, yet not perfectly).
# For reliable research results, add a free Tavily key — 1,000 searches/month,
# NO credit card required, at https://app.tavily.com (Dashboard -> API Keys).
# When set, Tavily is preferred and keyless engines are the automatic fallback.
# TAVILY_API_KEY=YOUR_TAVILY_API_KEY_HERE

# OPTIONAL: Override chat models
# GEMINI_MODEL=gemini-3.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=openrouter/free
# OPENAI_MODEL=gpt-5-mini
# SARVAM_LLM_MODEL=sarvam-105b

# OPTIONAL: Port for the backend (Render sets PORT automatically)
# PORT=3000