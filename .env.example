# Priya AI — environment variables
# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file (it is git-ignored).

# CHAT — primary: Sarvam AI (Indian-first LLM, native Hindi/Hinglish, works with the same key as voice)
# Get a free API key at https://dashboard.sarvam.ai (no credit card needed)
SARVAM_API_KEY=YOUR_SARVAM_API_KEY_HERE

# CHAT — optional: Google Gemini API key (create one free at https://aistudio.google.com/apikey)
# When set, Gemini is preferred for chat. Free tier covers the gemini-3.x flash family.
# GEMINI_API_KEY=YOUR_API_KEY_HERE

# CHAT — optional: Groq API key (free, no credit card at https://console.groq.com/keys)
# Free tier: llama-3.3-70b-versatile — 30 req/min, ~1,000 req/day. Great backup provider.
# GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# CHAT — optional: OpenRouter API key (https://openrouter.ai/keys) for free/other models.
# OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE

# CHAT — optional: OpenAI API key (https://platform.openai.com/api-keys) — paid service.
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# VOICE — primary: Sarvam AI (best natural Hindi + Hinglish voices, free tier)
# Used for: Hindi, Indian English, Hinglish code-switching, Indian names.
# (Uses the same SARVAM_API_KEY as chat.)

# VOICE — fallback: ElevenLabs (used only if Sarvam is not configured or fails)
# Optional. Free plan: 10,000 credits/month at https://elevenlabs.io
# ELEVENLABS_API_KEY=YOUR_ELEVENLABS_API_KEY_HERE

# OPTIONAL: Chat provider fallback order (comma-separated).
# Only providers with a configured key are used. On a rate limit / outage Priya
# cools that provider down for 90s and automatically falls back to the next one.
# Default: gemini,sarvam,groq,openrouter,openai
# CHAT_PROVIDERS=gemini,sarvam,groq,openrouter,openai

# OPTIONAL: Live web search. Priya searches the web with keyless engines (Bing/DuckDuckGo)
# out of the box — no key needed. If you have a Tavily/Brave/Serper API key you could
# connect it later via a small server change. No key is required.
# SEARCH_API_KEY=YOUR_KEY_HERE

# OPTIONAL: Override chat models
# GEMINI_MODEL=gemini-3.5-flash
# SARVAM_LLM_MODEL=sarvam-105b
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENAI_MODEL=gpt-4o-mini

# OPTIONAL: Port for the backend (Render sets PORT automatically)
# PORT=3000