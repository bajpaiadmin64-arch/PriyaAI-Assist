# Priya AI — environment variables
# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file (it is git-ignored).

# REQUIRED: Google Gemini API key (create one free at https://aistudio.google.com/apikey)
# Keep it secret. Only the backend reads it.
GEMINI_API_KEY=YOUR_API_KEY_HERE

# VOICE — primary: Sarvam AI (best natural Hindi + Hinglish voices, free tier)
# Get a free API key at https://dashboard.sarvam.ai (no credit card needed)
# Used for: Hindi, Indian English, Hinglish code-switching, Indian names.
SARVAM_API_KEY=YOUR_SARVAM_API_KEY_HERE

# VOICE — fallback: ElevenLabs (used only if Sarvam is not configured or fails)
# Optional. Free plan: 10,000 credits/month at https://elevenlabs.io
# ELEVENLABS_API_KEY=YOUR_ELEVENLABS_API_KEY_HERE

# OPTIONAL: Override the default model (defaults to the current free-tier Flash model)
# GEMINI_MODEL=gemini-3.6-flash

# OPTIONAL: Port for the backend (Render sets PORT automatically)
# PORT=3000
