# Priya AI — environment variables
# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file (it is git-ignored).

# CHAT — primary: Sarvam AI (Indian-first LLM, native Hindi/Hinglish, works with the same key as voice)
# Get a free API key at https://dashboard.sarvam.ai (no credit card needed)
SARVAM_API_KEY=YOUR_SARVAM_API_KEY_HERE

# CHAT — optional: Google Gemini API key (create one free at https://aistudio.google.com/apikey)
# When set, Gemini is preferred for chat. Free tier covers the gemini-3.x flash family.
# GEMINI_API_KEY=YOUR_API_KEY_HERE

# CHAT — optional: Groq API key (free, no credit card at https://console.groq.com/keys)
# Free tier: llama-3.3-70b-versatile — 30 req/min, ~1,000 req/day. Great backup provider.
# GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# CHAT — optional: OpenRouter API key (https://openrouter.ai/keys) for free/other models.
# OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE

# CHAT — optional: OpenAI API key (https://platform.openai.com/api-keys) — paid service.
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# CHAT — optional: every provider key below can ALSO be entered at runtime from
# Settings -> AI Models & API (stored server-side, gitignored, no restart).
# ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE        # https://console.anthropic.com/settings/keys
# XAI_API_KEY=YOUR_XAI_API_KEY_HERE                    # https://console.x.ai (Grok)
# DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY_HERE          # https://platform.deepseek.com/api_keys
# MISTRAL_API_KEY=YOUR_MISTRAL_API_KEY_HERE            # https://console.mistral.ai/api-keys
# TOGETHER_API_KEY=YOUR_TOGETHER_API_KEY_HERE          # https://api.together.ai/settings/api-keys
# CEREBRAS_API_KEY=YOUR_CEREBRAS_API_KEY_HERE          # https://cloud.cerebras.ai
# HF_API_KEY=YOUR_HF_API_KEY_HERE                      # Hugging Face token (Inference permission) — https://huggingface.co/settings/tokens
# PERPLEXITY_API_KEY=YOUR_PERPLEXITY_API_KEY_HERE      # https://www.perplexity.ai/settings/api

# VOICE — primary: Sarvam AI (best natural Hindi + Hinglish voices, free tier)
# Used for: Hindi, Indian English, Hinglish code-switching, Indian names.
# (Uses the same SARVAM_API_KEY as chat.)

# VOICE — fallback: ElevenLabs (used only if Sarvam is not configured or fails)
# Optional. Free plan: 10,000 credits/month at https://elevenlabs.io
# ELEVENLABS_API_KEY=YOUR_ELEVENLABS_API_KEY_HERE

# OPTIONAL: Chat provider fallback order (comma-separated).
# The model selected in Settings -> AI Models & API is always tried first,
# then this order. Only providers with a configured key are used. On a rate
# limit / outage Priya cools that provider down for 90s and automatically
# falls back to the next one.
# Default: gemini,sarvam,groq,openrouter,openai
# CHAT_PROVIDERS=gemini,sarvam,groq,openrouter,openai

# OPTIONAL: Live web search.
# WITHOUT a key: Priya searches with keyless engines (Bing/DuckDuckGo) — works
# but results can be unreliable (SEO junk is filtered, yet not perfectly).
# For reliable research results, add a free Tavily key — 1,000 searches/month,
# NO credit card required, at https://app.tavily.com (Dashboard -> API Keys).
# When set, Tavily is preferred and keyless engines are the automatic fallback.
# TAVILY_API_KEY=YOUR_TAVILY_API_KEY_HERE

# OPTIONAL: Override chat models
# GEMINI_MODEL=gemini-3.5-flash
# SARVAM_LLM_MODEL=sarvam-105b
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENAI_MODEL=gpt-4o-mini

# OPTIONAL: Port for the backend (Render sets PORT automatically)
# PORT=3000